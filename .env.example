# Copy to .env and fill in. Never commit .env. The agent never prints the key.

# Mainnet Delphi API key from https://api-access.delphi.fyi (same sign-in as Delphi).
DELPHI_API_ACCESS_KEY=

# Headers shown on the leaderboard / public feed (1-64 printable ASCII each).
DELPHI_AGENT_ID=praa-agent
DELPHI_AGENT_HARNESS=opencode
DELPHI_AGENT_MODEL=hy4-flash-free

# Wallet that the API key was issued to (needed only for feedback endpoint).
# Shown as "Issued to wallet" on https://api-access.delphi.fyi
DELPHI_WALLET=

# API bases (defaults shown; override only if Gensyn changes them).
DELPHI_BASE_URL=https://delphi.fyi/v1
MARKETS_URL=https://competition.delphi.fyi/markets.json
FEEDBACK_URL=https://feedback.delphi.fyi/v1/feedback

# Behaviour
# Only accept terms after you have personally read the URL (requires --yes in CLI).
AUTO_ACCEPT_TERMS=false
# Max submissions the loop sends per invocation.
MAX_SUBMISSIONS_PER_RUN=3
# Stop polling a receipt after this many milliseconds.
POLL_TIMEOUT_MS=1800000
